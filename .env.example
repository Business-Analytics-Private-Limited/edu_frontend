# Local settings for the frontend apps. Copy to apps/web/.env.local and apps/admin/.env.local
# (Next.js reads .env.local from each app's folder). Never commit real values.

# Where the backend API runs. Used only by the Next.js server, never sent to the browser.
API_URL=http://localhost:3000/api/v1

# Where `pnpm api:sync` downloads the API contract from (the backend must be running).
# API_CONTRACT_URL=http://localhost:3000/api/docs/openapi.json
