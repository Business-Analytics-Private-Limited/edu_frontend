{
  "name": "eduplatform-frontend",
  "private": true,
  "description": "EduPlatform frontend: web app and super admin console",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@eduplatform/web",
    "dev:admin": "turbo run dev --filter=@eduplatform/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:sync": "pnpm --filter @eduplatform/api sync",
    "api:check": "pnpm --filter @eduplatform/api check"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
